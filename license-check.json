{
  "license": "license-header.txt",
  "ignore": [
    ".angular/**",
    "**/*.html",
    "**/*.md",
    "**/*.txt",
    "**/*.mjs",
    "**/*.map",
    "**/*.lock",
    "**/*.editorconfig",
    "**/*.gitignore",
    "**/*.gitkeep",
    "**/*.npmignore",
    "**/LICENSE",
    "**/NOTICE",
    "**/licenses/**"
  ],
  "trailingWhitespace": "TRIM",
  "licenseFormats": {
    "ts": {
      "prepend": "///",
      "append": "///",
      "eachLine": {
        "prepend": "/// "
      }
    },
    "scss": {
      "prepend": "/**",
      "append": " */",
      "eachLine": {
        "prepend": " * "
      }
    }
  }
}
